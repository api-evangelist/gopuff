          "name": "Route Order to Gopuff",
          "request": {
            "name": "Route Order to Gopuff",
            "description": {
              "content": "Routes a completed Shopify checkout to the nearest Gopuff MFC for picking, packing, and delivery. Returns the Gopuff Order ID, which is also written back to the corresponding Shopify order's Additional details panel within 5 to 10 seconds.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "shops",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
